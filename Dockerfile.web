# Build stage
FROM node:20-slim AS builder

WORKDIR /app

# Install dependencies
COPY package*.json ./
# Skip prepare scripts and other lifecycle scripts - we only need web build deps
RUN npm ci --ignore-scripts

# Copy source
COPY . .

# Build the web app (vite.web.config.ts doesn't need Electron deps)
RUN npm run build:web

# Production stage
FROM nginx:alpine

# Copy built files
COPY --from=builder /app/dist-web /usr/share/nginx/html

# Copy nginx config
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
