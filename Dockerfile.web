# Build stage
FROM node:20-slim AS builder

WORKDIR /app

# Install git (needed by some Vite plugins) and build tools
RUN apt-get update && apt-get install -y git python3 make g++ && rm -rf /var/lib/apt/lists/*

# Install dependencies
COPY package*.json ./
# Use npm install (not ci) since there's no package-lock.json
# Skip prepare scripts - we only need web build deps, not Electron setup
RUN npm install --ignore-scripts

# Copy source
COPY . .

# Build the web app with verbose output
RUN npm run build:web 2>&1 || (echo "Build failed. Checking vite config..." && cat vite.web.config.ts && exit 1)

# Production stage
FROM nginx:alpine

# Copy built files
COPY --from=builder /app/dist-web /usr/share/nginx/html

# Copy nginx config
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
